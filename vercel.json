{
  "version": 2,
  "installCommand": "cd backend && npm install",
  "buildCommand": "",
  "functions": {
    "backend/api/index.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/(.*\\.(js|css|png|svg|ico|woff2?))",
      "dest": "/backend/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/public/index.html"
    }
  ]
}
